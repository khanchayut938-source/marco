end)

local delayBox=make("TextBox",loop,{
    Position=UDim2.fromOffset(20,120),
    Size=UDim2.new(1,-40,0,38),
    BackgroundColor3=Color3.fromRGB(36,39,62),
    TextColor3=Color3.new(1,1,1),
    Text="5",
    PlaceholderText="Replay delay in seconds",
    Font=Enum.Font.Gotham,
    TextSize=14
})

delayBox.FocusLost:Connect(function()
    local n=tonumber(delayBox.Text)
    if n and n>=1 then
        replayDelay=math.min(n,3600)
    else
        delayBox.Text=tostring(replayDelay)
    end
end)

